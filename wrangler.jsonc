{
  // Танзимоти Cloudflare барои сайти Raonson.
  //
  // ⚠️ Бе ин файл wrangler худаш тахмин мекард ва
  // `"directory": "."` мегузошт — яъне ТАМОМИ анборро ҳамчун сайт
  // нашр мекард: backend/, lib/, android/ ва ҳама чизи дигар.
  //
  // Акнун танҳо `_site/` нашр мешавад — он чи
  // `scripts/build-site.sh` ҷамъ мекунад.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raonson",
  "compatibility_date": "2026-09-11",
  // Фармони сохтан ҲАМИН ҶО, на дар dashboard.
  //
  // Дар dashboard майдони «Build command» холӣ монд ва барои ҳамин
  // `_site` сохта намешуд:
  //   ✘ assets.directory ... does not exist: /opt/buildhome/repo/_site
  //
  // wrangler ин фармонро ПЕШ аз нашр иҷро мекунад, пас танзимот дар
  // худи анбор мемонад ва касе онро дар интерфейс фаромӯш карда
  // наметавонад.
  "build": {
    "command": "bash scripts/cloudflare-build.sh"
  },
  "assets": {
    "directory": "_site",
    // Роҳи номаълум ба саҳифаи асосӣ намеравад — 404 медиҳад.
    // Вагарна Google ҳар роҳи вайронро ҳамчун саҳифаи воқеӣ
    // индекс мекунад.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
