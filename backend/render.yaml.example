# Template — copy to backend/render.yaml (git-ignored) OR set these as
# Environment Variables in your hosting dashboard (Render / Hugging Face).
# NEVER commit real secret values. Rotate any value that was ever committed.
services:
  - type: web
    name: raonson-api
    runtime: docker
    dockerfilePath: ./Dockerfile
    envVars:
      - key: PORT
        value: 10000
      - key: DATABASE_URL
        value: postgresql://USER:PASSWORD@HOST:5432/postgres
      - key: JWT_SECRET
        value: REPLACE_WITH_LONG_RANDOM_64CHARS
      - key: JWT_REFRESH_SECRET
        value: REPLACE_WITH_DIFFERENT_LONG_RANDOM_64CHARS
      - key: CF_ACCOUNT_ID
        value: ""
      - key: CF_R2_ACCESS_KEY
        value: ""
      - key: CF_R2_SECRET_KEY
        value: ""
      - key: CF_R2_BUCKET
        value: raonson-media
      - key: CF_R2_PUBLIC_URL
        value: ""
      - key: UPSTASH_REDIS_REST_URL
        value: ""
      - key: UPSTASH_REDIS_REST_TOKEN
        value: ""
      - key: FCM_SERVER_KEY
        value: ""
    healthCheckPath: /health
