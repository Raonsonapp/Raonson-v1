# ───────────────────────────────────────────────────────────────
#  Raonson backend — намунаи тағйирёбандаҳои муҳит (env)
#  Инҳоро дар Hugging Face Space → Settings → Variables and secrets
#  ҳамчун SECRET илова кунед (на дар код!).
# ───────────────────────────────────────────────────────────────

# ── EMAIL (барои рамзи барқарорсозии парол) — РОЙГОН бо Gmail ──
# 1. Дар ҳисоби Google: 2-Step Verification-ро фаъол кунед
#    (myaccount.google.com → Security → 2-Step Verification).
# 2. Баъд "App passwords" → барномаи нав → пароли 16-ҳарфа гиред.
# 3. Он паролро ин ҷо ҳамчун SMTP_PASS гузоред (бе фосила).
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
# Ихтиёрӣ (default-ҳо кор мекунанд):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=youraddress@gmail.com

# ── SMS ва WhatsApp (ихтиёрӣ, тавассути Twilio — ПУЛАКӢ) ──
# twilio.com → Console → Account SID ва Auth Token.
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_FROM=+1xxxxxxxxxx                 # рақами SMS-и Twilio
# TWILIO_WA_FROM=whatsapp:+14155238886     # рақами WhatsApp-и Twilio (sandbox ё расмӣ)

# ── Танзимоти иловагӣ ──
# Агар хоҳед, ки рамз дар production ҳам дар response баргардад (барои санҷиш):
# OTP_ECHO=1

# ── OpenAI (модератсияи AI, ҳэштеги худкор, тарҷумаи шарҳҳо) ──
# platform.openai.com → API keys → калиди нав созед ва ин ҷо ҳамчун
# SECRET гузоред (на дар код, на дар git!). Агар ин холӣ бошад, ин 3
# хусусият (модератсия/ҳэштег/тарҷума) хомӯш мемонанд — боқии барнома
# бе тағйир кор мекунад.
# OPENAI_API_KEY=sk-...
# Ихтиёрӣ (default: gpt-4o-mini — арзон ва кофӣ барои ҳэштег/тарҷума):
# OPENAI_MODEL=gpt-4o-mini

# ── Огоҳиномаҳои push (FCM HTTP v1) ──
#
# ⚠️ FCM_SERVER_KEY-и қаблӣ ДИГАР КОР НАМЕКУНАД. Google API-и кӯҳнаро
# (fcm.googleapis.com/fcm/send) хомӯш кард — он 404 бармегардонад.
# Бе танзимоти зерин ҳеҷ push фиристода намешавад; сатри огоҳинома
# дар барнома боз ҳам сохта мешавад.
#
# Чӣ тавр гирифтан:
#   console.firebase.google.com → Project settings → Service accounts
#   → «Generate new private key» → файли JSON фароварда мешавад.
#
# Ин файл СИР аст: ба git гузошта НАМЕШАВАД. Дар production онро
# ҳамчун secret гузоред (GitHub Secrets / HuggingFace Secrets).
#
# Роҳи 1 — худи JSON дар як сатр:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Роҳи 2 — роҳи файл дар сервер:
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
#
# Дар тарафи барнома (Flutter) android/app/google-services.json лозим
# аст — он сир НЕСТ, вале бояд ба ҲАМОН лоиҳаи Firebase тааллуқ дошта
# бошад.

# ── Танзими база (ихтиёрӣ) ──
#
# Ин рақамҳо ЧЕНШУДА мебошанд, на тахминӣ. Дар санҷиши бор (4 CPU,
# 50 000 корбари синтетикӣ) пули 25 беҳтарин натиҷа дод; 60 ва 12
# ҳарду БАДТАР буданд. Аз ин рӯ бе ченкунӣ онро калон накунед:
# пайвасти зиёд аз тавоноии Postgres худи Postgres-ро суст мекунад.
#
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5
#
# Маҳдудияти вақти дархост. Бе он як дархости суст пайвастро абадӣ
# нигоҳ медошт ва 25 чунин дархост тамоми API-ро мехобонд.
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TX_TIMEOUT_MS=30000

# ── Маҳдудияти суръат (ТАНҲО барои муҳити санҷиш) ──
#
# Ҳадҳоро чанд баробар мекунад. Дар production ГУЗОШТА НАШАВАД —
# он муҳофизатро аз селоби дархост суст мекунад.
# RATE_LIMIT_MULTIPLIER=100
