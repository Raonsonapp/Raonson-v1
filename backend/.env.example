# ───────────────────────────────────────────────────────────────
#  Raonson backend — намунаи тағйирёбандаҳои муҳит (env)
#  Инҳоро дар Hugging Face Space → Settings → Variables and secrets
#  ҳамчун SECRET илова кунед (на дар код!).
# ───────────────────────────────────────────────────────────────

# ── EMAIL (барои рамзи барқарорсозии парол) — РОЙГОН бо Gmail ──
# 1. Дар ҳисоби Google: 2-Step Verification-ро фаъол кунед
#    (myaccount.google.com → Security → 2-Step Verification).
# 2. Баъд "App passwords" → барномаи нав → пароли 16-ҳарфа гиред.
# 3. Он паролро ин ҷо ҳамчун SMTP_PASS гузоред (бе фосила).
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
# Ихтиёрӣ (default-ҳо кор мекунанд):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=youraddress@gmail.com

# ── SMS ва WhatsApp (ихтиёрӣ, тавассути Twilio — ПУЛАКӢ) ──
# twilio.com → Console → Account SID ва Auth Token.
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_FROM=+1xxxxxxxxxx                 # рақами SMS-и Twilio
# TWILIO_WA_FROM=whatsapp:+14155238886     # рақами WhatsApp-и Twilio (sandbox ё расмӣ)

# ── Танзимоти иловагӣ ──
# Агар хоҳед, ки рамз дар production ҳам дар response баргардад (барои санҷиш):
# OTP_ECHO=1
