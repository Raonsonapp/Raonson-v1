# ═══════════════════════════════════════════════════════════════════
#  Raonson — намунаи танзимот.
#  Ин файл ба repo меафтад. Дар он ҳеҷ ГОҲ secret-и воқеӣ нанависед —
#  .env худаш дар .gitignore аст.
# ═══════════════════════════════════════════════════════════════════

# ── Асосӣ ──
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=7860

# ── Creator Marketplace ──
# Комиссияи платформа бо фоиз (0..100). Дар ҳар кампания ҳангоми
# сохтан қуфл мешавад — тағйири баъдӣ ба кампанияи кӯҳна таъсир надорад.
PLATFORM_COMMISSION_PERCENT=10
MARKETPLACE_CURRENCY=TJS

# Provider-и пардохт. "mock" танҳо барои development/тест аст ва
# ҳеҷ пул интиқол намедиҳад. Барои production номи provider-и воқеиро
# гузоред — вале танҳо баъд аз пайваст кардани adapter-и он.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Provider-и payout. "manual" маънои онро дорад, ки интиқоли ХУДКОР
# нест: ҳар payout ба REQUIRES_ACTION меравад ва оператор онро дастӣ
# иҷро мекунад. Ин қасдан аст — payout-и сохта хатари молиявист.
PAYOUT_PROVIDER=manual
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
PAYOUT_WEBHOOK_SECRET=

# ── Хидматҳои мавҷуда ──
AGORA_APP_ID=
BREVO_API_KEY=
BREVO_SENDER=
TELEGRAM_GATEWAY_TOKEN=
