# ═══════════════════════════════════════════════════════════════════
#  Raonson — намунаи танзимот.
#  Ин файл ба repo меафтад. Дар он ҳеҷ ГОҲ secret-и воқеӣ нанависед —
#  .env худаш дар .gitignore аст.
# ═══════════════════════════════════════════════════════════════════

# ── Асосӣ ──
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=7860

# ── Creator Marketplace ──
# Комиссияи платформа бо фоиз (0..100). Дар ҳар кампания ҳангоми
# сохтан қуфл мешавад — тағйири баъдӣ ба кампанияи кӯҳна таъсир надорад.
PLATFORM_COMMISSION_PERCENT=10
MARKETPLACE_CURRENCY=TJS

# Provider-и пардохт. "mock" танҳо барои development/тест аст ва
# ҳеҷ пул интиқол намедиҳад. Барои production номи provider-и воқеиро
# гузоред — вале танҳо баъд аз пайваст кардани adapter-и он.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Provider-и payout. "manual" маънои онро дорад, ки интиқоли ХУДКОР
# нест: ҳар payout ба REQUIRES_ACTION меравад ва оператор онро дастӣ
# иҷро мекунад. Ин қасдан аст — payout-и сохта хатари молиявист.
PAYOUT_PROVIDER=manual
PAYOUT_API_KEY=
PAYOUT_API_SECRET=
PAYOUT_WEBHOOK_SECRET=

# ── Хидматҳои мавҷуда ──
AGORA_APP_ID=
BREVO_API_KEY=
BREVO_SENDER=
TELEGRAM_GATEWAY_TOKEN=

# ── AI (LLM) ──
# Raonson бо ҳар provider-и OpenAI-compatible кор мекунад — аз ҷумла
# variant-ҳои РОЙГОН (Groq, OpenRouter, Together, DeepInfra ва ғ.).
# Калиди пулакии OpenAI ЛОЗИМ НЕСТ.
#
# Ҳадди ақал AI_API_KEY-ро гузоред — ҳама вазифаҳо кор мекунанд:
AI_API_KEY=
# URL-и OpenAI-compatible. Пешфарз: Groq.
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# Модели умумӣ барои ҳама вазифаҳо.
AI_MODEL=llama-3.3-70b-versatile

# Барои ҳар вазифа модели ҶУДОГОНА (ихтиёрӣ).
# Номи моделро аз рӯйхати provider-и худ гиред — онҳо бо вақт тағйир
# меёбанд, бинобар ин ин ҷо номи сахткодшуда нест.
#   chat     — муошират, ёрдамчӣ, муаллим
#   code     — коднависӣ
#   analysis — таҳлил ва хулоса (Creator Insights)
#   fast     — вазифаҳои хурд: хэштег, тарҷума, холи сифат
#   vision   — таҳлили расм
AI_CHAT_MODEL=
AI_CODE_MODEL=
AI_ANALYSIS_MODEL=
AI_FAST_MODEL=
AI_VISION_MODEL=

# Агар вазифаҳо аз provider-ҳои ГУНОГУН оянд, ҳар кадом калид ва
# URL-и худро гирифта метавонад:
# AI_CODE_API_KEY=
# AI_CODE_API_URL=
# AI_VISION_API_KEY=
# AI_VISION_API_URL=

# Танзимоти кӯҳна ҳанӯз кор мекунад (fallback):
# TUTOR_API_KEY / TUTOR_API_URL / TUTOR_MODEL
# OPENAI_API_KEY — танҳо барои endpoint-и /moderations лозим аст;
# бе он модератсия бо худи модел иҷро мешавад.
